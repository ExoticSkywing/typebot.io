# Make sure to change this to your own random string of 32 characters (https://docs.typebot.io/self-hosting/deploy/docker#2-add-the-required-configuration)
ENCRYPTION_SECRET=do+UspMmB/rewbX2K/rskFmtgGSSZ8Ta

# Database & Cache (Host-native infrastructure)
DATABASE_URL=postgresql://typebot_kefu:password@127.0.0.1:5432/typebot_kefu
REDIS_URL=redis://127.0.0.1:6379

NODE_OPTIONS=--no-node-snapshot

# Domains (Builder on 3170, Viewer on 3180)
NEXTAUTH_URL=https://typebot.1yo.cc
NEXT_PUBLIC_VIEWER_URL=https://kefu.1yo.cc

# Required when using Webhook blocks. Generate an independent random secret
# (at least 32 characters), shared by builder, viewer and PartyKit server vars.
WEBHOOK_RELAY_SECRET=

ADMIN_EMAIL=
DEFAULT_WORKSPACE_PLAN=UNLIMITED

# Optional: use the OIDC UserInfo endpoint for Custom OAuth profile claims (default: false).
CUSTOM_OAUTH_USE_USERINFO=false
# For more configuration options check out: https://docs.typebot.io/self-hosting/configuration
